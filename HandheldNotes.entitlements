<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "https://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<!-- REQUIRED for CloudKit. cloudd rejects the container outright —
	     "Invalid value of (null) for entitlement com.apple.application-identifier …
	     access to CloudKit will be denied" — unless this is present. Xcode injects it
	     automatically; this app is hand-bundled (swift build + manual codesign), so it
	     must be set explicitly. Must be TEAMID.BUNDLEID and match the embedded profile. -->
	<key>com.apple.application-identifier</key>
	<string>2J5S7H2LTB.com.mohammadshobaki.handheldnotes</string>
	<key>com.apple.developer.team-identifier</key>
	<string>2J5S7H2LTB</string>
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.com.mohammadshobaki.handheldnotes</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
	<key>com.apple.developer.aps-environment</key>
	<string>development</string>
	<!-- DEV signing: this Mac build uses the macOS *Development* provisioning profile
	     (Apple Development cert), so it lives on the same development push network as the
	     from-Xcode iPhone build. Both apps therefore share one CloudKit environment AND
	     one APNs environment — which is what makes incremental sync instant in BOTH
	     directions. The production values live in HandheldNotes-release.entitlements
	     (HC_SIGN=release). aps + container-environment MUST match the embedded profile,
	     or AMFI denies launch (error 163). -->
	<key>com.apple.developer.icloud-container-environment</key>
	<string>Development</string>
</dict>
</plist>
