<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "https://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<key>com.apple.security.device.bluetooth</key>
	<true/>
	<!-- REQUIRED for CloudKit. cloudd rejects the container outright —
	     "Invalid value of (null) for entitlement com.apple.application-identifier …
	     access to CloudKit will be denied" — unless this is present. Xcode injects it
	     automatically; this app is hand-bundled (swift build + manual codesign), so it
	     must be set explicitly. Must be TEAMID.BUNDLEID and match the Developer ID profile. -->
	<key>com.apple.application-identifier</key>
	<string>2J5S7H2LTB.com.mohammadshobaki.handheldnotes</string>
	<key>com.apple.developer.team-identifier</key>
	<string>2J5S7H2LTB</string>
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.com.mohammadshobaki.handheldnotes</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
	<key>com.apple.developer.aps-environment</key>
	<string>production</string>
	<!-- This is a `swift build -c debug` binary, which would otherwise default to
	     the DEVELOPMENT CloudKit environment. The iPhone app is pinned to Production,
	     so pin the Mac there too — otherwise they sync to different "rooms" of the
	     same iCloud account and never converge. Matches the Developer ID profile. -->
	<key>com.apple.developer.icloud-container-environment</key>
	<string>Production</string>
</dict>
</plist>
